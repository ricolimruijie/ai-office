# Copy this file to .env and fill in the token. .env is git-ignored. Restart `npm run dev` after editing it.

# Bot token from https://discord.com/developers/applications (Bot tab). Keep it secret.
DISCORD_TOKEN=

# Your server and the channel where the robots post progress.
DISCORD_GUILD_ID=1556831406410174565
DISCORD_CHANNEL_ID=1556831406410174568

# Optional: comma-separated Discord user ids allowed to give tasks. Empty means anyone in the server.
DISCORD_ALLOWED_USER_IDS=

# Optional: "assigned" (default) posts progress only for tasks given from Discord. "all" also posts the random mock activity.
DISCORD_FEED=assigned
